{
    "version": 2,
    "builds": [
      {
        "src": "About.html",
        "use": "@vercel/static"
      },
      {
        "src": "assets/*",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/about",
        "dest": "/About.html"
      },
      {
        "src": "/(.*)",
        "dest": "/$1"
      }
    ]
  }
  